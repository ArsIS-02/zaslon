# ----------------------------------------------------------------------------- utils
def run(args, timeout=60, stdin=None):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout, env=ENV, input=stdin)
        return p.returncode, p.stdout, p.stderr.strip()
    except FileNotFoundError:
        return 127, "", f"{args[0]}: not found"
    except subprocess.TimeoutExpired:
        return 124, "", f"{' '.join(args)}: timeout"


def have(cmd):
    return shutil.which(cmd, path=ENV["PATH"]) is not None


def out(obj, code=0):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False))
    sys.stdout.write("\n")
    sys.exit(code)


def fail(msg, **kw):
    out(dict(ok=False, error=msg, **kw), 1)


def read(path, default=""):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read()
    except OSError:
        return default


class Bad(Exception):
    pass


RE_NAME = re.compile(r"[A-Za-z0-9_.:+][A-Za-z0-9_.:+-]{0,63}")
RE_IFACE = re.compile(r"[A-Za-z0-9_.@:][A-Za-z0-9_.@:-]{0,31}")
RE_PORT = re.compile(r"\d{1,5}(-\d{1,5})?")
PROTOS = ("tcp", "udp", "sctp", "dccp")
TARGETS = ("default", "ACCEPT", "DROP", "%%REJECT%%", "REJECT")
LOGDENIED = ("off", "all", "unicast", "broadcast", "multicast")
TABLES = ("filter", "nat", "mangle", "raw", "security")


def v_name(x, what="имя"):
    if not isinstance(x, str) or not RE_NAME.fullmatch(x):
        raise Bad(f"недопустимое {what}: {x!r}")
    return x


def v_port(x):
    x = str(x)
    if not RE_PORT.fullmatch(x):
        raise Bad(f"недопустимый порт: {x!r}")
    for p in x.split("-"):
        if not 0 < int(p) < 65536:
            raise Bad(f"порт вне диапазона: {x}")
    return x


def v_proto(x):
    if x not in PROTOS:
        raise Bad(f"недопустимый протокол: {x!r}")
    return x


def v_addr(x):
    try:
        if "/" in str(x):
            ipaddress.ip_network(x, strict=False)
        else:
            ipaddress.ip_address(x)
    except ValueError:
        if isinstance(x, str) and re.fullmatch(r"ipset:[A-Za-z0-9_][A-Za-z0-9_.-]{0,63}", x):
            return x
        raise Bad(f"недопустимый адрес: {x!r}")
    return str(x)


def v_text(x, maxlen=1000, what="значение"):
    if not isinstance(x, str) or not x.strip() or len(x) > maxlen or any(c in x for c in "\n\r\x00"):
        raise Bad(f"недопустимое {what}")
    return x.strip()


# ----------------------------------------------------------------------------- parsers (testable)
def parse_fw_blocks(text):
    """Parse output of `firewall-cmd --list-all-zones` / `--list-all-policies` / `--zone=X --list-all`."""
    res = {}
    cur = None
    key = None
    for line in text.splitlines():
        if not line.strip():
            continue
        if not line.startswith((" ", "\t")):
            m = re.match(r"^(\S+)(?:\s+\((.*)\))?\s*$", line)
            if not m:
                continue
            flags = [f.strip() for f in (m.group(2) or "").split(",") if f.strip()]
            cur = {"name": m.group(1), "active": "active" in flags, "default": "default" in flags}
            res[cur["name"]] = cur
            key = None
            continue
        if cur is None:
            continue
        if line.startswith("\t") or (key == "rich rules" and line.startswith("    ")) or (key == "rich rules" and line.lstrip().startswith("rule")):
            if key == "rich rules":
                cur.setdefault("rich_rules", []).append(line.strip())
            continue
        m = re.match(r"^\s+([a-z0-9 -]+):\s?(.*)$", line)
        if not m:
            continue
        key = m.group(1).strip()
        val = m.group(2).strip()
        k = key.replace(" ", "_").replace("-", "_")
        if key in ("interfaces", "sources", "services", "ports", "protocols", "source-ports",
                   "icmp-blocks", "ingress-zones", "egress-zones", "forward-ports"):
            if key == "forward-ports":
                # values look like: port=80:proto=tcp:toport=8080:toaddr=  (several, space separated)
                cur[k] = [v for v in re.split(r"\s+(?=port=)", val) if v]
            else:
                cur[k] = val.split() if val else []
        elif key == "rich rules":
            cur["rich_rules"] = [val] if val else []
        elif key in ("masquerade", "forward", "icmp-block-inversion"):
            cur[k] = val == "yes"
        else:
            cur[k] = val
    for z in res.values():
        z.setdefault("rich_rules", [])
    return res


def parse_ss(text):
    rows = []
    for line in text.splitlines():
        parts = line.split()
        if len(parts) < 5:
            continue
        netid, state = parts[0], parts[1]
        local = parts[4]
        proc = " ".join(parts[6:]) if len(parts) > 6 else ""
        addr, _, port = local.rpartition(":")
        if not port.isdigit():
            continue
        addr = addr.strip("[]")
        scope = ""
        if "%" in addr:
            addr, scope = addr.split("%", 1)
        procs = re.findall(r'\("([^"]+)",pid=(\d+)', proc)
        rows.append({
            "proto": "tcp" if netid.startswith("tcp") else ("udp" if netid.startswith("udp") else netid),
            "state": state, "addr": addr, "scope": scope, "port": int(port),
            "process": procs[0][0] if procs else "", "pid": int(procs[0][1]) if procs else None,
            "processes": sorted({p[0] for p in procs}),
            "local_only": addr in ("127.0.0.1", "::1") or addr.startswith("127.") or scope == "lo",
        })
    return rows


def parse_iptables_save(text):
    """-> {table: {"chains": {name: {"policy", "packets", "bytes"}}, "rules": [{chain, rule, packets, bytes, line}]}}"""
    tables = {}
    cur = None
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("*"):
            cur = tables.setdefault(line[1:], {"chains": {}, "rules": []})
            continue
        if cur is None or line == "COMMIT":
            continue
        cnt = None
        m = re.match(r"^\[(\d+):(\d+)\]\s+(.*)$", line)
        if m:
            cnt = (int(m.group(1)), int(m.group(2)))
            line = m.group(3)
        if line.startswith(":"):
            m = re.match(r"^:(\S+)\s+(\S+)(?:\s+\[(\d+):(\d+)\])?", line)
            if m:
                cur["chains"][m.group(1)] = {"policy": m.group(2),
                                             "packets": int(m.group(3) or 0), "bytes": int(m.group(4) or 0)}
            continue
        if line.startswith("-A "):
            chain = line.split()[1]
            cur["rules"].append({"chain": chain, "rule": line,
                                 "packets": cnt[0] if cnt else None, "bytes": cnt[1] if cnt else None})
    return tables


def parse_semanage_bool(text):
    res = []
    for line in text.splitlines():
        m = re.match(r"^(\S+)\s+\((on|off)\s*,\s*(on|off)\)\s*(.*)$", line)
        if m:
            res.append({"name": m.group(1), "state": m.group(2) == "on",
                        "default": m.group(3) == "on", "description": m.group(4).strip()})
    return res


def parse_semanage_port(text):
    res = []
    for line in text.splitlines():
        m = re.match(r"^(\S+_t)\s+(tcp|udp|sctp|dccp)\s+(.+)$", line)
        if m:
            res.append({"type": m.group(1), "proto": m.group(2),
                        "ports": [p.strip() for p in m.group(3).split(",") if p.strip()]})
    return res


def parse_kv_colon(text):
    res = {}
    for line in text.splitlines():
        if ":" in line:
            k, v = line.split(":", 1)
            res[k.strip()] = v.strip()
    return res


def parse_avc(text, limit=200):
    events = []
    for rec in text.split("\n----"):
        for line in rec.splitlines():
            if not line.startswith(("type=AVC", "type=USER_AVC")):
                continue
            ev = {"raw": line[:2000]}
            m = re.search(r"msg=audit\(([^)]*)\)", line)
            if m:
                ev["time"] = m.group(1).rsplit(":", 1)[0]
            m = re.search(r"avc:\s+(denied|granted)\s+\{\s*([^}]*)\}", line)
            if m:
                ev["result"] = m.group(1)
                ev["perms"] = m.group(2).split()
            for k in ("comm", "name", "path", "scontext", "tcontext", "tclass", "permissive", "pid", "dest", "src"):
                m = re.search(r"\b%s=(\"[^\"]*\"|\S+)" % k, line)
                if m:
                    ev[k] = m.group(1).strip('"')
            events.append(ev)
    return events[-limit:]


def parse_services_xml(dirs=("/usr/lib/firewalld/services", "/etc/firewalld/services")):
    cat = {}
    for d in dirs:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for fn in names:
            if not fn.endswith(".xml"):
                continue
            try:
                root = ET.parse(os.path.join(d, fn)).getroot()
            except Exception:
                continue
            ports = [f"{p.get('port')}/{p.get('protocol')}" for p in root.findall("port")]
            cat[fn[:-4]] = {
                "short": (root.findtext("short") or "").strip(),
                "description": " ".join((root.findtext("description") or "").split())[:300],
                "ports": ports,
                "custom": d.startswith("/etc"),
            }
    return cat


def port_in(port, proto, items):
    """Is port/proto covered by list like ['22/tcp', '1000-2000/udp']"""
    for it in items:
        if "/" not in it:
            continue
        rng, pr = it.split("/", 1)
        if pr != proto:
            continue
        a, _, b = rng.partition("-")
        try:
            if int(a) <= port <= int(b or a):
                return True
        except ValueError:
            pass
    return False


# ----------------------------------------------------------------------------- firewalld
def fw_running():
    rc, o, _ = run(["firewall-cmd", "--state"], timeout=15)
    return rc == 0 and o.strip() == "running"


def fw_cmd(args, permanent=False, timeout=60):
    a = ["firewall-cmd"] + (["--permanent"] if permanent else []) + args
    return run(a, timeout=timeout)


def peer_zone(peer, zones):
    """Which runtime zone handles traffic from peer: by source, else by interface of the route, else default."""
    if not peer:
        return None, None
    try:
        pip = ipaddress.ip_address(peer)
    except ValueError:
        return None, None
    for z in zones.values():
        for s in z.get("sources", []):
            try:
                if pip in ipaddress.ip_network(s, strict=False):
                    return z["name"], f"source {s}"
            except ValueError:
                continue
    rc, o, _ = run(["ip", "route", "get", peer], timeout=10)
    m = re.search(r"\bdev\s+(\S+)", o)
    dev = m.group(1) if m else None
    if dev:
        for z in zones.values():
            if dev in z.get("interfaces", []):
                return z["name"], f"interface {dev}"
    for z in zones.values():
        if z.get("default"):
            return z["name"], f"default zone (interface {dev or '?'})"
    return None, dev


def ssh_ports():
    rc, o, _ = run(["sshd", "-T"], timeout=15)
    ports = [int(l.split()[1]) for l in o.splitlines() if l.startswith("port ")]
    return ports or [22]


def rich_info(r):
    """Very small rich-rule reader: priority, action, source (with NOT), service/port/other element."""
    i = {"rule": r}
    m = re.search(r'priority="(-?\d+)"', r)
    i["priority"] = int(m.group(1)) if m else 0
    m = re.search(r"\b(accept|drop|reject|mark)\b", re.sub(r'"[^"]*"', '""', r))
    i["action"] = m.group(1) if m else None
    m = re.search(r'family="(ipv4|ipv6)"', r)
    i["family"] = m.group(1) if m else None
    m = re.search(r'source\s+(NOT\s+)?address="([^"]+)"', r)
    i["src"] = (m.group(2), bool(m.group(1))) if m else None
    i["src_ipset"] = bool(re.search(r'source\s+(NOT\s+)?ipset=', r))
    i["opaque"] = bool(re.search(r'\b(destination|mac=|ipset=)', r))  # условия, которые не можем проверить
    m = re.search(r'service\s+name="([^"]+)"', r)
    i["service"] = m.group(1) if m else None
    m = re.search(r'(?<![-\w])port\s+port="([^"]+)"\s+protocol="([^"]+)"', r)
    i["port"] = (m.group(1), m.group(2)) if m else None
    i["other_element"] = bool(re.search(r"\b(protocol value|icmp-block|icmp-type|forward-port|source-port|masquerade)\b", r)) and not i["port"]
    return i


def rule_hits(i, pip, sshp, services_cat):
    """Может ли правило сработать для SSH-соединения панели. Непроверяемые условия трактуем осторожно:
    запрещающее правило — «сработает», разрешающее — «не сработает»."""
    if i["family"] and i["family"] != ("ipv4" if pip.version == 4 else "ipv6"):
        return False
    if i["opaque"]:
        return i["action"] in ("drop", "reject")
    if i["src"]:
        try:
            hit = pip in ipaddress.ip_network(i["src"][0], strict=False)
        except ValueError:
            return False
        if hit == i["src"][1]:
            return False
    if i["service"]:
        return any(port_in(p, "tcp", services_cat.get(i["service"], {}).get("ports", [])) for p in sshp)
    if i["port"]:
        return i["port"][1] == "tcp" and any(port_in(p, "tcp", [f"{i['port'][0]}/tcp"]) for p in sshp)
    return not i["other_element"]


def ssh_allowed(peer, zones, services_cat, sshp=None):
    """Heuristic model of firewalld evaluation order: is SSH from peer still accepted (runtime)?"""
    sshp = sshp or ssh_ports()
    zname, why = peer_zone(peer, zones)
    if not zname:
        return True, "зона не определена"
    z = zones[zname]
    pip = ipaddress.ip_address(peer)
    for fp in z.get("forward_ports", []):
        m = re.search(r"port=(\d+)(?:-(\d+))?:proto=tcp", fp)
        if m and any(int(m.group(1)) <= p <= int(m.group(2) or m.group(1)) for p in sshp):
            return False, f"зона {zname}: проброс {fp} перехватывает порт SSH"
    rules = [rich_info(r) for r in z.get("rich_rules", [])]
    hits = [i for i in rules if i["action"] in ("accept", "drop", "reject") and rule_hits(i, pip, sshp, services_cat)]
    where = f"зона {zname} ({why})"

    def verdict(i):
        return (i["action"] == "accept", f"{where}: rich rule «{i['rule']}»")

    for i in sorted((i for i in hits if i["priority"] < 0), key=lambda i: i["priority"]):
        return verdict(i)
    for i in hits:
        if i["priority"] == 0 and i["action"] in ("drop", "reject"):
            return verdict(i)
    for i in hits:
        if i["priority"] == 0 and i["action"] == "accept":
            return verdict(i)
    for p in sshp:
        if port_in(p, "tcp", z.get("ports", [])):
            return True, f"{where}: порт {p}/tcp открыт"
    for s in z.get("services", []):
        if any(port_in(p, "tcp", services_cat.get(s, {}).get("ports", [])) for p in sshp):
            return True, f"{where}: служба {s}"
    for i in sorted((i for i in hits if i["priority"] > 0), key=lambda i: i["priority"]):
        return verdict(i)
    if z.get("target") == "ACCEPT":
        return True, f"{where}: target ACCEPT"
    return False, f"{where}: SSH (порт {','.join(map(str, sshp))}/tcp) не разрешён"


def fw_zones(permanent=False):
    rc, o, e = fw_cmd(["--list-all-zones"], permanent=permanent)
    return parse_fw_blocks(o) if rc == 0 else {}


# ----------------------------------------------------------------------------- collect
def collect(peer=None):
    errors = []
    d = {"helper": VERSION, "time": int(time.time()), "peer": peer}

    def safe(name, fn):
        try:
            d[name] = fn()
        except Exception as ex:  # noqa
            errors.append(f"{name}: {ex}")

    def facts():
        osr = read("/etc/redos-release").strip() or read("/etc/os-release")
        model = read("/proc/device-tree/model").replace("\x00", "").strip()
        rc, o, _ = run(["systemd-detect-virt"], timeout=5)
        rc2, ip_o, _ = run(["ip", "-j", "addr"], timeout=10)
        addrs = []
        try:
            for i in json.loads(ip_o or "[]"):
                if i.get("ifname", "").startswith(("veth", "lo")):
                    continue
                for a in i.get("addr_info", []):
                    if a.get("scope") == "global":
                        addrs.append({"ifname": i["ifname"], "addr": a["local"], "prefix": a["prefixlen"],
                                      "family": a["family"], "state": i.get("operstate")})
        except ValueError:
            pass
        un = os.uname()
        up = read("/proc/uptime").split()
        return {"hostname": un.nodename, "os": osr.splitlines()[0] if osr else "", "kernel": un.release,
                "arch": un.machine, "model": model, "virt": o.strip(), "addresses": addrs,
                "uptime": int(float(up[0])) if up else None}

    def firewalld():
        rc, o, _ = run(["systemctl", "is-active", "firewalld"], timeout=10)
        rc2, en, _ = run(["systemctl", "is-enabled", "firewalld"], timeout=10)
        f = {"installed": have("firewall-cmd"), "active": o.strip() == "active", "enabled": en.strip()}
        conf = read("/etc/firewalld/firewalld.conf")
        f["conf"] = {k: v for k, v in re.findall(r"^(\w+)=(.*)$", conf, re.M)}
        if not f["installed"] or not fw_running():
            f["running"] = False
            return f
        f["running"] = True
        f["version"] = run(["firewall-cmd", "--version"])[1].strip()
        f["default_zone"] = run(["firewall-cmd", "--get-default-zone"])[1].strip()
        f["log_denied"] = run(["firewall-cmd", "--get-log-denied"])[1].strip()
        f["panic"] = run(["firewall-cmd", "--query-panic"])[0] == 0
        f["zones"] = fw_zones(False)
        f["zones_permanent"] = fw_zones(True)
        rc, o, _ = run(["firewall-cmd", "--list-all-policies"])
        f["policies"] = parse_fw_blocks(o) if rc == 0 else {}
        f["ipsets"] = run(["firewall-cmd", "--get-ipsets"])[1].split()
        f["icmptypes"] = run(["firewall-cmd", "--get-icmptypes"])[1].split()
        drt = run(["firewall-cmd", "--direct", "--get-all-rules"])[1]
        drp = run(["firewall-cmd", "--permanent", "--direct", "--get-all-rules"])[1]
        f["direct_rules"] = [l for l in drt.splitlines() if l.strip()]
        f["direct_rules_permanent"] = [l for l in drp.splitlines() if l.strip()]
        f["services_catalog"] = parse_services_xml()
        # drift runtime vs permanent
        drift = []
        for zn, z in f["zones"].items():
            p = f["zones_permanent"].get(zn, {})
            for k in ("services", "ports", "sources", "rich_rules", "forward_ports", "icmp_blocks", "protocols"):
                a, b = set(z.get(k, [])), set(p.get(k, []))
                for x in sorted(a - b):
                    drift.append({"zone": zn, "kind": k, "value": x, "where": "runtime-only"})
                for x in sorted(b - a):
                    drift.append({"zone": zn, "kind": k, "value": x, "where": "permanent-only"})
            if z.get("masquerade") != p.get("masquerade") and p:
                drift.append({"zone": zn, "kind": "masquerade", "value": str(z.get("masquerade")), "where": "runtime"})
            if z.get("target") != p.get("target") and p:
                drift.append({"zone": zn, "kind": "target", "value": f"{z.get('target')} / {p.get('target')}",
                              "where": "runtime / permanent"})
        f["drift"] = drift
        return f

    def iptables():
        r = {}
        for fam, cmd in (("ipv4", "iptables"), ("ipv6", "ip6tables")):
            if not have(cmd + "-save"):
                continue
            rc, o, e = run([cmd + "-save", "-c"])
            r[fam] = {"text": o, "tables": parse_iptables_save(o), "error": e if rc else ""}
        r["version"] = run(["iptables", "-V"])[1].strip()
        rc, o, _ = run(["iptables-legacy-save"]) if have("iptables-legacy-save") else (1, "", "")
        r["legacy_rules"] = len([l for l in o.splitlines() if l.startswith("-A")])
        r["service"] = run(["systemctl", "is-active", "iptables"])[1].strip()
        return r

    def nftables():
        rc, o, e = run(["nft", "list", "tables"])
        tables = []
        for l in o.splitlines():
            p = l.split()
            if len(p) == 3 and p[0] == "table":
                rc2, t, _ = run(["nft", "-a", "list", "table", p[1], p[2]])
                tables.append({"family": p[1], "name": p[2],
                               "rules": len(re.findall(r"^\t\t(?!type |policy |flags |elements |typeof |counter$|comment ).*# handle \d+$", t, re.M)),
                               "chains": len(re.findall(r"^\tchain ", t, re.M)),
                               "managed_by": ("firewalld" if p[2] == "firewalld" else
                                              "iptables-nft" if "managed by iptables-nft" in t else "")})
        return {"version": run(["nft", "--version"])[1].strip(), "tables": tables,
                "service": run(["systemctl", "is-active", "nftables"])[1].strip()}

    def listening():
        rc, o, _ = run(["ss", "-tulpnH"])
        return parse_ss(o)

    def selinux():
        s = {"tools": have("getenforce")}
        if not s["tools"]:
            return s
        s["mode"] = run(["getenforce"])[1].strip()
        st = parse_kv_colon(run(["sestatus"])[1])
        s["status"] = st
        conf = read("/etc/selinux/config")
        m = re.search(r"^SELINUX=(\S+)", conf, re.M)
        s["config_mode"] = m.group(1) if m else ""
        m = re.search(r"^SELINUXTYPE=(\S+)", conf, re.M)
        s["policy"] = m.group(1) if m else ""
        s["semanage"] = have("semanage")
        if s["mode"] == "Disabled":
            return s
        if s["semanage"]:
            rc, o, e = run(["semanage", "boolean", "-l"], timeout=120)
            s["booleans"] = parse_semanage_bool(o)
            s["booleans_local"] = [b["name"] for b in parse_semanage_bool(run(["semanage", "boolean", "-l", "-C"], timeout=120)[1])]
            s["ports"] = parse_semanage_port(run(["semanage", "port", "-l"], timeout=120)[1])
            s["ports_local"] = parse_semanage_port(run(["semanage", "port", "-l", "-C"], timeout=120)[1])
            fc = run(["semanage", "fcontext", "-l", "-C"], timeout=120)[1]
            s["fcontext_local"] = [l for l in fc.splitlines()[1:] if l.strip() and not l.startswith("SELinux")][:200]
            pm = run(["semanage", "permissive", "-l"], timeout=60)[1]
            cust, on = [], False
            for l in pm.splitlines():
                if l.lower().startswith("customized"):
                    on = True
                elif l.lower().startswith("builtin"):
                    on = False
                elif on and l.strip():
                    cust.append(l.strip())
            s["permissive_domains"] = cust
        else:
            rc, o, _ = run(["getsebool", "-a"])
            s["booleans"] = [{"name": a, "state": b.strip() == "on", "default": None, "description": ""}
                             for a, b in (l.split("-->") for l in o.splitlines() if "-->" in l)]
        rc, o, _ = run(["ausearch", "-m", "AVC,USER_AVC,SELINUX_ERR", "-ts", "today", "-i"], timeout=60)
        s["avc_today"] = parse_avc(o, 100)
        return s

    def fail2ban():
        f = {"installed": have("fail2ban-client"),
             "active": run(["systemctl", "is-active", "fail2ban"])[1].strip() == "active"}
        if not (f["installed"] and f["active"]):
            return f
        rc, o, _ = run(["fail2ban-client", "status"], timeout=20)
        m = re.search(r"Jail list:\s*(.*)", o)
        jails = [j.strip() for j in (m.group(1) if m else "").split(",") if j.strip()]
        f["jails"] = []
        for j in jails:
            rc, o, _ = run(["fail2ban-client", "status", j], timeout=20)
            banned = re.search(r"Banned IP list:\s*(.*)", o)
            total = re.search(r"Total banned:\s*(\d+)", o)
            failed = re.search(r"Currently failed:\s*(\d+)", o)
            ign = run(["fail2ban-client", "get", j, "ignoreip"], timeout=20)[1]
            f["jails"].append({"name": j, "banned": (banned.group(1).split() if banned else []),
                               "total_banned": int(total.group(1)) if total else None,
                               "currently_failed": int(failed.group(1)) if failed else None,
                               "ignoreip": [x for x in re.findall(r"[0-9a-fA-F:.]+(?:/\d+)?", "\n".join(ign.splitlines()[1:]))
                                            if re.search(r"\d", x) and len(x) > 2]})
        return f

    def sshd():
        rc, o, _ = run(["sshd", "-T"], timeout=15)
        keep = ("port", "listenaddress", "permitrootlogin", "passwordauthentication", "pubkeyauthentication",
                "allowusers", "allowgroups", "denyusers", "maxauthtries", "maxstartups", "x11forwarding",
                "permitemptypasswords", "kbdinteractiveauthentication", "persourcepenalties")
        res = {}
        for l in o.splitlines():
            k, _, v = l.partition(" ")
            if k in keep:
                res.setdefault(k, []).append(v)
        return {k: (v[0] if len(v) == 1 else v) for k, v in res.items()}

    def misc():
        return {"docker": run(["systemctl", "is-active", "docker"])[1].strip(),
                "podman": have("podman"),
                "cockpit": run(["systemctl", "is-active", "cockpit.socket"])[1].strip(),
                "networkmanager": run(["systemctl", "is-active", "NetworkManager"])[1].strip()}

    safe("facts", facts)
    safe("firewalld", firewalld)
    safe("iptables", iptables)
    safe("nftables", nftables)
    safe("listening", listening)
    safe("selinux", selinux)
    safe("fail2ban", fail2ban)
    safe("sshd", sshd)
    safe("misc", misc)
    if peer and d.get("firewalld", {}).get("running"):
        try:
            zn, why = peer_zone(peer, d["firewalld"]["zones"])
            okk, reason = ssh_allowed(peer, d["firewalld"]["zones"], d["firewalld"]["services_catalog"])
            d["peer_info"] = {"zone": zn, "why": why, "ssh_allowed": okk, "reason": reason}
        except Exception as ex:  # noqa
            errors.append(f"peer: {ex}")
    d["pending"] = pending_list()
    d["errors"] = errors
    d["ok"] = True
    return d


# ----------------------------------------------------------------------------- ops
# Each op handler returns list of (description, inverse_op or None). Raises Bad on validation errors,
# RuntimeError on execution errors.
SIMPLE_FW = {
    # op: (query flag, add flag, remove flag, value builder)
    "port": ("--query-port", "--add-port", "--remove-port",
             lambda o: f"{v_port(o['port'])}/{v_proto(o.get('proto', 'tcp'))}"),
    "service": ("--query-service", "--add-service", "--remove-service", lambda o: v_name(o["service"], "имя службы")),
    "source": ("--query-source", "--add-source", "--remove-source", lambda o: v_addr(o["source"])),
    "rich": ("--query-rich-rule", "--add-rich-rule", "--remove-rich-rule",
             lambda o: v_rich(o["rule"])),
    "icmp-block": ("--query-icmp-block", "--add-icmp-block", "--remove-icmp-block",
                   lambda o: v_name(o["icmptype"], "тип ICMP")),
    "forward-port": ("--query-forward-port", "--add-forward-port", "--remove-forward-port", lambda o: fwd_value(o)),
    "protocol": ("--query-protocol", "--add-protocol", "--remove-protocol", lambda o: v_name(o["protocol"], "протокол")),
}


def v_rich(r):
    r = v_text(r, 2000, "rich rule")
    if not r.startswith("rule"):
        raise Bad("rich rule должно начинаться со слова rule")
    return r


def fwd_value(o):
    s = f"port={v_port(o['port'])}:proto={v_proto(o.get('proto', 'tcp'))}"
    if o.get("toport"):
        s += f":toport={v_port(o['toport'])}"
    if o.get("toaddr"):
        s += f":toaddr={v_addr(o['toaddr'])}"
    if not o.get("toport") and not o.get("toaddr"):
        raise Bad("для проброса нужен toport и/или toaddr")
    return s


def layers_of(o):
    ls = []
    if o.get("runtime", True):
        ls.append(False)
    if o.get("permanent", True):
        ls.append(True)
    if not ls:
        raise Bad("не выбран ни runtime, ни permanent")
    return ls


def need_fw():
    if not fw_running():
        raise RuntimeError("firewalld не запущен")


def h_simple_fw(o):
    need_fw()
    q, add, rem, build = SIMPLE_FW[o["op"]]
    action = o.get("action")
    if action not in ("add", "remove"):
        raise Bad("action должен быть add или remove")
    zone = v_name(o.get("zone") or run(["firewall-cmd", "--get-default-zone"])[1].strip(), "имя зоны")
    val = build(o)
    for perm in layers_of(o):
        rc, _, _ = fw_cmd([f"--zone={zone}", f"{q}={val}"], permanent=perm)
        present = rc == 0
        if (action == "add") == present:
            yield (f"{'permanent' if perm else 'runtime'}: без изменений ({val} {'уже есть' if present else 'нет'})", None)
            continue
        flag = add if action == "add" else rem
        extra = []
        if action == "add" and not perm and o.get("timeout"):
            extra = [f"--timeout={int(o['timeout'])}"]
        rc, so, se = fw_cmd([f"--zone={zone}", f"{flag}={val}"] + extra, permanent=perm)
        if rc != 0:
            raise RuntimeError(f"firewall-cmd {flag}={val}: {se or so}")
        inv = dict(o, action="remove" if action == "add" else "add",
                   runtime=not perm, permanent=perm, zone=zone)
        inv.pop("timeout", None)
        yield (f"{'permanent' if perm else 'runtime'}: {flag} {val} (зона {zone})", inv)


def h_masquerade(o):
    need_fw()
    action = o.get("action")
    if action not in ("add", "remove"):
        raise Bad("action должен быть add или remove")
    zone = v_name(o["zone"], "имя зоны")
    for perm in layers_of(o):
        present = fw_cmd([f"--zone={zone}", "--query-masquerade"], permanent=perm)[0] == 0
        if (action == "add") == present:
            continue
        rc, so, se = fw_cmd([f"--zone={zone}", "--add-masquerade" if action == "add" else "--remove-masquerade"], permanent=perm)
        if rc:
            raise RuntimeError(se or so)
        yield (f"masquerade {action} ({zone})", dict(o, action="remove" if action == "add" else "add",
                                                           runtime=not perm, permanent=perm))


def h_interface(o):
    need_fw()
    action = o.get("action")
    zone = v_name(o["zone"], "имя зоны")
    iface = o.get("interface")
    if not RE_IFACE.fullmatch(iface or ""):
        raise Bad(f"недопустимый интерфейс {iface!r}")
    for perm in layers_of(o):
        rc, cur, _ = fw_cmd([f"--get-zone-of-interface={iface}"], permanent=perm)
        cur = cur.strip() if rc == 0 else ""
        if action in ("add", "change"):
            if cur == zone:
                continue
            rc, so, se = fw_cmd([f"--zone={zone}", f"--change-interface={iface}"], permanent=perm)
            inv = (dict(o, action="change", zone=cur, runtime=not perm, permanent=perm) if cur else
                   dict(o, action="remove", runtime=not perm, permanent=perm))
        elif action == "remove":
            if cur != zone:
                continue
            rc, so, se = fw_cmd([f"--zone={zone}", f"--remove-interface={iface}"], permanent=perm)
            inv = dict(o, action="add", runtime=not perm, permanent=perm)
        else:
            raise Bad("action: add | change | remove")
        if rc:
            raise RuntimeError(se or so)
        yield (f"interface {iface}: {cur or '—'} → {zone if action != 'remove' else '—'}", inv)


def reload_firewalld():
    rc, so, se = fw_cmd(["--reload"])
    if rc:
        raise RuntimeError("reload: " + (se or so))
    # reload сбрасывает runtime-правила, в том числе баны fail2ban — перезапуск восстановит их из его базы
    if run(["systemctl", "is-active", "fail2ban"])[1].strip() == "active":
        run(["systemctl", "try-restart", "fail2ban"], timeout=120)


def h_target(o):
    need_fw()
    zone = v_name(o["zone"], "имя зоны")
    target = o.get("target")
    if target not in TARGETS:
        raise Bad("target: default | ACCEPT | DROP | %%REJECT%%")
    if target == "REJECT":
        target = "%%REJECT%%"
    cur = fw_cmd([f"--zone={zone}", "--get-target"], permanent=True)[1].strip()
    if cur == target:
        yield ("target без изменений", None)
        return
    rc, so, se = fw_cmd([f"--zone={zone}", f"--set-target={target}"], permanent=True)
    if rc:
        raise RuntimeError(se or so)
    yield (f"target зоны {zone}: {cur} → {target} (firewalld перечитал правила; runtime-изменения сброшены)", dict(o, target=cur))
    reload_firewalld()


def h_default_zone(o):
    need_fw()
    zone = v_name(o["zone"], "имя зоны")
    cur = run(["firewall-cmd", "--get-default-zone"])[1].strip()
    if cur == zone:
        return [("зона по умолчанию без изменений", None)]
    rc, so, se = run(["firewall-cmd", f"--set-default-zone={zone}"])
    if rc:
        raise RuntimeError(se or so)
    return [(f"зона по умолчанию: {cur} → {zone}", dict(o, zone=cur))]


def h_log_denied(o):
    need_fw()
    v = o.get("value")
    if v not in LOGDENIED:
        raise Bad("value: " + " | ".join(LOGDENIED))
    cur = run(["firewall-cmd", "--get-log-denied"])[1].strip()
    if cur == v:
        return [("LogDenied без изменений", None)]
    rc, so, se = run(["firewall-cmd", f"--set-log-denied={v}"])
    if rc:
        raise RuntimeError(se or so)
    return [(f"LogDenied: {cur} → {v}", dict(o, value=cur))]


def h_service_unit(o):
    unit = o.get("unit", "firewalld")
    if unit not in ("firewalld", "fail2ban"):
        raise Bad("управлять можно только firewalld и fail2ban")
    action = o.get("action")
    if action in ("start", "stop"):
        cur = run(["systemctl", "is-active", unit])[1].strip() == "active"
        if (action == "start") == cur:
            return [(f"{unit} уже {'запущен' if cur else 'остановлен'}", None)]
    elif action in ("enable", "disable"):
        cur = run(["systemctl", "is-enabled", unit])[1].strip() == "enabled"
        if (action == "enable") == cur:
            return [(f"{unit} без изменений", None)]
    else:
        raise Bad("action: start | stop | enable | disable")
    rc, so, se = run(["systemctl", action, unit], timeout=120)
    if rc:
        raise RuntimeError(se or so)
    inv = {"start": "stop", "stop": "start", "enable": "disable", "disable": "enable"}[action]
    return [(f"systemctl {action} {unit}", dict(o, action=inv))]


FORBIDDEN_IPT = re.compile(r"(-M|--modprobe.*|-t|--table.*|-[AIDRFXNPELSZ]|--(append|insert|delete|replace|flush|delete-chain|new-chain|policy|rename-chain|list|list-rules|zero|check)(=.*)?)")


def safe_ipt_tokens(tokens):
    for t in tokens:
        if FORBIDDEN_IPT.fullmatch(t):
            raise Bad(f"параметр {t} в правиле не допускается")
    return tokens


def direct_args(o):
    fam = o.get("family", "ipv4")
    if fam not in ("ipv4", "ipv6"):
        raise Bad("family: ipv4 | ipv6")
    table = o.get("table", "filter")
    if table not in TABLES:
        raise Bad("недопустимая таблица")
    chain = v_name(o.get("chain", "INPUT"), "цепочка")
    prio = str(int(o.get("priority", 0)))
    args = safe_ipt_tokens(shlex.split(v_text(o.get("args", ""), 1000, "аргументы правила")))
    return [fam, table, chain, prio] + args


def h_direct(o):
    need_fw()
    action = o.get("action")
    if action not in ("add", "remove"):
        raise Bad("action должен быть add или remove")
    a = direct_args(o)
    for perm in layers_of(o):
        present = fw_cmd(["--direct", "--query-rule"] + a, permanent=perm)[0] == 0
        if (action == "add") == present:
            continue
        rc, so, se = fw_cmd(["--direct", "--add-rule" if action == "add" else "--remove-rule"] + a, permanent=perm)
        if rc:
            raise RuntimeError(se or so)
        yield (f"direct {action}: {' '.join(a)}", dict(o, action="remove" if action == "add" else "add",
                                                               runtime=not perm, permanent=perm))


def ipt_bin(o):
    b = {"ipv4": "iptables", "ipv6": "ip6tables"}.get(o.get("family", "ipv4"))
    if not b:
        raise Bad("family: ipv4 | ipv6")
    return b


def h_iptables(o):
    """Runtime-only change of iptables (e.g. remove a Wazuh/fail2ban drop rule)."""
    binr = ipt_bin(o)
    table = o.get("table", "filter")
    if table not in TABLES:
        raise Bad("недопустимая таблица")
    rule = shlex.split(v_text(o.get("rule", ""), 1000, "правило"))
    if len(rule) < 3 or rule[0] not in ("-A", "-I"):
        raise Bad("правило должно быть в виде '-A ЦЕПОЧКА ...'")
    chain = v_name(rule[1], "цепочка")
    spec = rule[2:]
    if spec and spec[0].isdigit():
        spec = spec[1:]
    safe_ipt_tokens(spec)
    exists = run([binr, "-w", "5", "-t", table, "-C", chain] + spec)[0] == 0
    action = o.get("action")
    if action == "delete":
        if not exists:
            yield ("правила нет — нечего удалять", None)
            return
        lst = [l for l in run([binr, "-w", "5", "-t", table, "-S", chain])[1].splitlines() if l.startswith("-A ")]
        pos = next((i + 1 for i, l in enumerate(lst) if shlex.split(l)[2:] == spec), None)
        if pos is None:
            raise Bad("правило записано не в каноническом виде — возьмите строку из списка правил (iptables -S)")
        rc, so, se = run([binr, "-w", "5", "-t", table, "-D", chain] + spec)
        if rc:
            raise RuntimeError(se or so)
        yield (f"{binr} -t {table} -D {chain} {' '.join(spec)}",
               dict(o, action="insert", position=pos, rule=" ".join(["-A", chain] + [shlex.quote(x) for x in spec])))
        return
    if action in ("insert", "append"):
        if exists:
            yield ("такое правило уже есть", None)
            return
        if action == "insert":
            cmd = [binr, "-w", "5", "-t", table, "-I", chain, str(int(o.get("position", 1)))] + spec
        else:
            cmd = [binr, "-w", "5", "-t", table, "-A", chain] + spec
        rc, so, se = run(cmd)
        if rc:
            raise RuntimeError(se or so)
        yield (" ".join(cmd[3:]), dict(o, action="delete"))
        return
    raise Bad("action: delete | insert | append")


def selinux_on():
    if not have("getenforce"):
        raise RuntimeError("SELinux не установлен")
    m = run(["getenforce"])[1].strip()
    if m == "Disabled":
        raise RuntimeError("SELinux выключен (Disabled) — изменить можно только режим в конфиге")
    return m


def h_se_enforce(o):
    cur = selinux_on()
    v = str(o.get("value"))
    if v not in ("0", "1"):
        raise Bad("value: 0 (permissive) | 1 (enforcing)")
    if (cur == "Enforcing") == (v == "1"):
        return [("режим без изменений", None)]
    rc, so, se = run(["setenforce", v])
    if rc:
        raise RuntimeError(se or so)
    return [(f"setenforce {v} ({cur} → {'Enforcing' if v == '1' else 'Permissive'})",
             dict(o, value="1" if cur == "Enforcing" else "0"))]


def h_se_config(o):
    v = o.get("value")
    if v not in ("enforcing", "permissive", "disabled"):
        raise Bad("value: enforcing | permissive | disabled")
    path = "/etc/selinux/config"
    conf = read(path)
    m = re.search(r"^SELINUX=(\S+)", conf, re.M)
    cur = m.group(1) if m else ""
    if cur == v:
        return [("конфиг без изменений", None)]
    new = re.sub(r"^SELINUX=\S*", f"SELINUX={v}", conf, flags=re.M) if m else conf + f"\nSELINUX={v}\n"
    tmp = path + ".zaslon-tmp"
    with open(tmp, "w") as f:
        f.write(new)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
    run(["restorecon", path])
    note = ""
    if cur == "disabled" and v != "disabled":
        note = " — нужна перезагрузка и полная переразметка файлов (touch /.autorelabel)"
    elif v == "disabled":
        note = " — вступит в силу после перезагрузки"
    else:
        note = " — режим после перезагрузки"
    return [(f"SELINUX={cur} → {v}{note}", dict(o, value=cur or "enforcing"))]


def h_sebool(o):
    selinux_on()
    name = v_name(o["name"], "имя переключателя")
    v = o.get("value")
    if v not in ("on", "off"):
        raise Bad("value: on | off")
    rc, cur, se = run(["getsebool", name])
    if rc:
        raise RuntimeError(se or cur)
    curv = cur.split("-->")[-1].strip()
    if curv == v:
        return [(f"{name} уже {v}", None)]
    args = ["setsebool"] + (["-P"] if o.get("persist", True) else []) + [name, v]
    rc, so, se = run(args, timeout=300)
    if rc:
        raise RuntimeError(se or so)
    return [(f"{name}: {curv} → {v}{' (постоянно)' if o.get('persist', True) else ''}", dict(o, value=curv))]


def h_seport(o):
    selinux_on()
    if not have("semanage"):
        raise RuntimeError("нет semanage (policycoreutils-python-utils)")
    t = v_name(o["type"], "тип порта")
    if not t.endswith("_t"):
        raise Bad("тип порта должен оканчиваться на _t")
    proto = v_proto(o.get("proto", "tcp"))
    port = v_port(o["port"])
    local = parse_semanage_port(run(["semanage", "port", "-l", "-C"], timeout=120)[1])
    has = any(p["type"] == t and p["proto"] == proto and port in p["ports"] for p in local)
    action = o.get("action")
    if action == "add":
        if has:
            return [("такая метка порта уже есть", None)]
        rc, so, se = run(["semanage", "port", "-a", "-t", t, "-p", proto, port], timeout=300)
        if rc and "already defined" in (se + so):
            rc, so, se = run(["semanage", "port", "-m", "-t", t, "-p", proto, port], timeout=300)
        if rc:
            raise RuntimeError(se or so)
        return [(f"semanage port: {port}/{proto} → {t}", dict(o, action="delete"))]
    if action == "delete":
        if not has:
            return [("локальной метки нет — нечего удалять", None)]
        rc, so, se = run(["semanage", "port", "-d", "-t", t, "-p", proto, port], timeout=300)
        if rc:
            raise RuntimeError(se or so)
        return [(f"semanage port: удалена {port}/{proto} {t}", dict(o, action="add"))]
    raise Bad("action: add | delete")


def h_f2b_unban(o):
    ip = v_addr(o["ip"])
    rc, so, se = run(["fail2ban-client", "unban", ip], timeout=30)
    if rc:
        raise RuntimeError(se or so)
    return [(f"fail2ban: снят бан {ip}", None)]


