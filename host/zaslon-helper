HANDLERS.update({
    "masquerade": h_masquerade, "interface": h_interface, "target": h_target,
    "default-zone": h_default_zone, "log-denied": h_log_denied, "unit": h_service_unit,
    "direct": h_direct, "iptables": h_iptables,
    "selinux-enforce": h_se_enforce, "selinux-config": h_se_config,
    "sebool": h_sebool, "seport": h_seport, "f2b-unban": h_f2b_unban,
})


# ----------------------------------------------------------------------------- transactions
def tx_path(txid):
    if not re.fullmatch(r"[0-9]{14}-[0-9a-f]{6}", txid or ""):
        fail("bad id")
    return os.path.join(TXDIR, txid + ".json")


def tx_save(tx):
    os.makedirs(TXDIR, mode=0o700, exist_ok=True)
    p = tx_path(tx["id"])
    with open(p + ".tmp", "w") as f:
        json.dump(tx, f, ensure_ascii=False, indent=1)
    os.replace(p + ".tmp", p)


def tx_load(txid):
    try:
        with open(tx_path(txid)) as f:
            return json.load(f)
    except OSError:
        fail(f"транзакция {txid} не найдена")


def pending_list():
    res = []
    try:
        names = os.listdir(TXDIR)
    except OSError:
        return res
    for fn in names:
        if fn.endswith(".json"):
            try:
                with open(os.path.join(TXDIR, fn)) as f:
                    tx = json.load(f)
                if tx.get("status") == "pending":
                    res.append({k: tx.get(k) for k in ("id", "created", "deadline", "note")})
            except (OSError, ValueError):
                pass
    return res


def lock():
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    f = open(os.path.join(STATE, "lock"), "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fcntl.flock(f, fcntl.LOCK_EX)
    return f


def backup_firewalld(txid):
    if os.path.isdir("/etc/firewalld"):
        os.makedirs(TXDIR, mode=0o700, exist_ok=True)
        with tarfile.open(os.path.join(TXDIR, txid + "-firewalld.tgz"), "w:gz") as t:
            t.add("/etc/firewalld", arcname="firewalld")


def cleanup_old(keep=60):
    try:
        files = sorted((os.path.getmtime(os.path.join(TXDIR, f)), f) for f in os.listdir(TXDIR))
    except OSError:
        return
    for _, f in files[:-keep * 2]:
        try:
            os.remove(os.path.join(TXDIR, f))
        except OSError:
            pass


RISKY = {"interface", "target", "default-zone", "unit", "direct", "iptables", "source", "forward-port", "masquerade"}


def is_risky(o):
    if o["op"] in RISKY:
        return True
    if o["op"] in ("port", "service") and o.get("action") == "remove":
        return True
    if o["op"] == "rich" and re.search(r"\b(drop|reject)\b", o.get("rule", "")):
        return True
    return False


def apply(peer=None):
    try:
        req = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        fail("ожидался JSON на stdin")
    ops = req.get("ops") or []
    if not isinstance(ops, list) or not ops or len(ops) > 200:
        fail("нет операций")
    try:
        rollback = int(req.get("rollback", 60))
    except (TypeError, ValueError):
        fail("rollback: число секунд")
    if rollback < 30 and not req.get("force"):
        fail("таймер отката должен быть не меньше 30 секунд")
    rollback = min(rollback, 3600)
    for o in ops:
        if not isinstance(o, dict) or o.get("op") not in HANDLERS:
            fail(f"неизвестная операция: {o!r}")
    lk = lock()
    txid = time.strftime("%Y%m%d%H%M%S") + "-" + uuid.uuid4().hex[:6]
    try:
        backup_firewalld(txid)
    except Exception:  # noqa
        pass
    tx = {"id": txid, "created": int(time.time()), "note": str(req.get("note", ""))[:300], "peer": peer,
          "ops": ops, "inverse": [], "results": [], "status": "applying", "rollback": rollback}
    tx_save(tx)
    # таймер — ДО первого изменения: если helper или соединение оборвутся посередине, хост всё равно откатится
    if rollback > 0:
        tx["deadline"] = int(time.time()) + rollback
        tx["timer"] = arm_timer(txid, rollback)
        tx_save(tx)
    error = None
    for i, o in enumerate(ops):
        try:
            for desc, inv in HANDLERS[o["op"]](o):
                tx["results"].append({"op": i, "ok": True, "text": desc})
                if inv:
                    tx["inverse"].append(inv)
                tx_save(tx)          # каждое уже сделанное изменение сразу попадает в журнал отката
        except Bad as ex:
            error = f"операция {i + 1}: {ex}"
        except Exception as ex:  # noqa
            error = f"операция {i + 1}: {ex}"
        if error:
            tx["results"].append({"op": i, "ok": False, "text": error})
            break
    # защита от потери доступа: проверяем и текущие, и сохранённые правила
    guard = None
    if not error and peer and fw_running():
        try:
            cat = parse_services_xml()
            sshp = ssh_ports()
            ok_rt, why_rt = ssh_allowed(peer, fw_zones(False), cat, sshp)
            ok_pm, why_pm = ssh_allowed(peer, fw_zones(True), cat, sshp)
            guard = {"ssh_allowed": ok_rt and ok_pm, "reason": why_rt if not ok_rt else why_pm if not ok_pm else why_rt}
            if not ok_rt and not req.get("force"):
                error = "изменение закрыло бы SSH для панели ZaSlon: " + why_rt
            elif not ok_pm and not req.get("force"):
                error = "после перезагрузки SSH для панели ZaSlon был бы закрыт: " + why_pm
        except Exception as ex:  # noqa
            guard = {"ssh_allowed": None, "reason": str(ex)}
    tx["guard"] = guard
    if error:
        undo = do_inverse(tx)
        tx["status"] = "failed"
        tx["error"] = error
        tx["undo"] = undo
        tx["undo_incomplete"] = any(not u["ok"] for u in undo)
        tx_save(tx)
        stop_timer(txid)
        out({"ok": False, "error": error, "tx": tx}, 1)
    if rollback > 0 and tx["inverse"]:
        tx["status"] = "pending"
    else:
        tx["status"] = "confirmed"
        stop_timer(txid)
    tx_save(tx)
    cleanup_old()
    lk.close()
    out({"ok": True, "tx": tx})


def stop_timer(txid):
    run(["systemctl", "stop", f"zaslon-rb-{txid}.timer"], timeout=20)


def arm_timer(txid, seconds):
    unit = f"zaslon-rb-{txid}"
    rc, so, se = run(["systemd-run", f"--unit={unit}", f"--on-active={seconds}s",
                      "--timer-property=AccuracySec=1s", "--description=ZaSlon rollback " + txid,
                      SELF, "rollback", txid, "--auto"], timeout=30)
    if rc == 0:
        return {"kind": "systemd", "unit": unit}
    subprocess.Popen(["setsid", "sh", "-c", f"sleep {int(seconds)}; exec {shlex.quote(SELF)} rollback {txid} --auto"],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
                     start_new_session=True)
    return {"kind": "sleep", "error": se}


def do_inverse(tx):
    res = []
    for inv in reversed(tx.get("inverse", [])):
        try:
            for desc, _ in HANDLERS[inv["op"]](inv):
                res.append({"ok": True, "text": desc})
        except Exception as ex:  # noqa
            res.append({"ok": False, "text": f"{inv.get('op')}: {ex}"})
    return res


def confirm(txid):
    lk = lock()
    tx = tx_load(txid)
    if tx.get("status") != "pending":
        out({"ok": tx.get("status") == "confirmed", "status": tx.get("status"), "tx": tx})
    stop_timer(txid)
    tx["status"] = "confirmed"
    tx["confirmed"] = int(time.time())
    tx_save(tx)
    lk.close()
    out({"ok": True, "status": "confirmed", "tx": tx})


def rollback(txid, auto=False):
    lk = lock()
    tx = tx_load(txid)
    if not (tx.get("status") in ("pending", "applying") or (tx.get("status") == "failed" and tx.get("undo_incomplete"))):
        out({"ok": True, "status": tx.get("status"), "note": "откат не требуется"})
    if not auto:
        stop_timer(txid)
    tx["undo"] = do_inverse(tx)
    tx["status"] = "rolled_back"
    tx["rolled_back"] = int(time.time())
    tx["rolled_back_by"] = "timer" if auto else "user"
    tx_save(tx)
    lk.close()
    out({"ok": True, "status": "rolled_back", "tx": tx})


def history(n=30):
    res = []
    try:
        names = sorted((f for f in os.listdir(TXDIR) if f.endswith(".json")), reverse=True)[:n]
    except OSError:
        names = []
    for fn in names:
        try:
            with open(os.path.join(TXDIR, fn)) as f:
                tx = json.load(f)
            res.append({k: tx.get(k) for k in ("id", "created", "status", "note", "results", "error",
                                                "rolled_back_by", "deadline")})
        except (OSError, ValueError):
            pass
    out({"ok": True, "history": res})


# ----------------------------------------------------------------------------- main
def main():
    a = sys.argv[1:]
    if not a:
        fail("usage: version | collect | nft-table | avc | apply | confirm | rollback | pending | history")
    peer = None
    if "--peer" in a:
        i = a.index("--peer")
        peer = a[i + 1] if i + 1 < len(a) else None
        del a[i:i + 2]
        try:
            ipaddress.ip_address(peer or "")
        except ValueError:
            peer = None
    cmd = a[0]
    if os.geteuid() != 0 and cmd not in ("version",):
        fail("нужен root (sudo)")
    if cmd == "version":
        out({"ok": True, "version": VERSION})
    if cmd == "collect":
        out(collect(peer))
    if cmd == "nft-table":
        if len(a) < 3 or a[1] not in ("ip", "ip6", "inet", "arp", "bridge", "netdev") or not RE_NAME.fullmatch(a[2]):
            fail("nft-table FAMILY NAME")
        rc, o, e = run(["nft", "-a", "list", "table", a[1], a[2]])
        out({"ok": rc == 0, "text": o, "error": e})
    if cmd == "avc":
        since = a[2] if len(a) > 2 and a[1] == "--since" else "today"
        if since not in ("today", "recent", "boot", "this-week", "yesterday"):
            since = "today"
        rc, o, e = run(["ausearch", "-m", "AVC,USER_AVC,SELINUX_ERR", "-ts", since, "-i"], timeout=120)
        out({"ok": True, "events": parse_avc(o, 500)})
    if cmd == "apply":
        apply(peer)
    if cmd == "confirm" and len(a) > 1:
        confirm(a[1])
    if cmd == "rollback" and len(a) > 1:
        rollback(a[1], auto="--auto" in a)
    if cmd == "pending":
        out({"ok": True, "pending": pending_list()})
    if cmd == "history":
        history()
    fail("неизвестная команда")


if __name__ == "__main__":
    main()
