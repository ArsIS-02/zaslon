#!/usr/bin/python3
import sys, json, os
S="/tmp/fake/fw.json"
base={"public":{"ports":["22/tcp"],"services":["ssh"],"rich":[],"sources":[],"interfaces":["eth0"],"target":"default"},
      "trusted":{"ports":[],"services":[],"rich":[],"sources":[],"interfaces":[],"target":"ACCEPT"}}
st=json.load(open(S)) if os.path.exists(S) else {"rt":base,"default":"public"}
if "pm" not in st: st["pm"]=json.loads(json.dumps(st["rt"]))
a=sys.argv[1:]; perm="--permanent" in a; a=[x for x in a if x!="--permanent"]
L=st["pm" if perm else "rt"]
zone=st["default"]
for x in a:
    if x.startswith("--zone="): zone=x.split("=",1)[1]
a=[x for x in a if not x.startswith("--zone=")]
def save(): json.dump(st,open(S,"w"))
c=a[0] if a else ""
k,_,v=c.partition("=")
m={"port":"ports","service":"services","rich-rule":"rich","source":"sources"}
if c=="--state": print("running"); sys.exit(0)
if c=="--get-default-zone": print(st["default"]); sys.exit(0)
if c=="--list-all-zones":
    for zn,z in L.items():
        print(f"{zn} ({'default, ' if zn==st['default'] else ''}active)")
        print(f"  target: {z['target']}\n  interfaces: {' '.join(z['interfaces'])}\n  sources: {' '.join(z['sources'])}\n  services: {' '.join(z['services'])}\n  ports: {' '.join(z['ports'])}\n  masquerade: no\n  forward-ports: \n  rich rules: ")
        for r in z["rich"]: print("\t"+r)
    sys.exit(0)
for verb in ("query","add","remove"):
    for kk,f in m.items():
        if k==f"--{verb}-{kk}":
            lst=L[zone][f]
            if verb=="query": sys.exit(0 if v in lst else 1)
            if verb=="add" and perm and kk=="source" and v.startswith("10.9."):
                print("Error: ZONE_CONFLICT", file=sys.stderr); sys.exit(13)
            if verb=="add" and v not in lst: lst.append(v)
            if verb=="remove" and v in lst: lst.remove(v)
            save(); print("success"); sys.exit(0)
if c.startswith("--get-zone-of-interface"):
    for zn,z in L.items():
        if v in z["interfaces"]: print(zn); sys.exit(0)
    sys.exit(2)
print("unsupported", a, file=sys.stderr); sys.exit(0)
